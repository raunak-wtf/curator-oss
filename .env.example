APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=YOUR_AUTH0_DOMAIN
AUTH0_CLIENT_ID=YOUR_AUTH0_CLIENT_ID
AUTH0_CLIENT_SECRET=YOUR_AUTH0_CLIENT_SECRET
AUTH0_SECRET=YOUR_64_CHARACTER_HEX_SECRET

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Managed Cognix Cloud Neon PostgreSQL provisioning (server-only).
# When set, Cognix auto-provisions an isolated Neon project per user app and unlocks the neon_database agent tool.
NEON_API_KEY=
NEON_ORG_ID=
NEON_DEFAULT_REGION=aws-us-east-1

# Managed Cognix Cloud Storage provisioning via Bucketline (server-only; never exposed to sandboxes).
# Docs: https://cloudnest-cdn-vault.lovable.app/docs#operations
BUCKETLINE_API_KEY=
BUCKETLINE_BASE_URL=https://cloudnest-cdn-vault.lovable.app

DAYTONA_API_KEY=YOUR_DAYTONA_API_KEY
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

# Custom domains for published apps. Hosts listed here always serve Cognix itself.
# Custom domain routing stays off until APP_BASE_URL or COGNIX_APP_HOSTS is set.
COGNIX_APP_HOSTS=
# CNAME target customers point their subdomains at. Defaults to the APP_BASE_URL host.
COGNIX_DOMAIN_CNAME_TARGET=
# Optional IPv4 address for root domains, which cannot use a CNAME.
COGNIX_DOMAIN_IPV4=
# Optional. With a Cloudflare token that can edit DNS in the customer's zone,
# Cognix creates and removes the records instead of showing manual instructions.
CLOUDFLARE_API_TOKEN=
# Cloudflare for SaaS zone that accepts customer hostnames and runs cloudflare/edge-worker.js.
# The token above needs "SSL and Certificates: Edit" on this zone.
COGNIX_CF_SAAS_ZONE_ID=
# Shared with the edge proxy (`vm/edge-proxy.mjs` or `cloudflare/edge-worker.js`). It authenticates the forwarded
# hostname, Caddy's On-Demand TLS `ask` check, and Daytona preview token lookups. Generate: openssl rand -hex 32
COGNIX_EDGE_SECRET=
# Optional wildcard domain (e.g. curatorsite.in) for direct Lovable-style random preview subdomains
# (`<random-slug>.curatorsite.in`) and published apps (`<name>.curatorsite.in`).
COGNIX_APPS_DOMAIN=
# Optional idle minutes before a published sandbox scales to zero and wakes on the next visit (0 = continuous).
COGNIX_PUBLISHED_AUTOSTOP_MINUTES=15

# Any provider exposing an OpenAI-compatible Chat Completions API.
OPENAI_API_KEY=YOUR_OPENAI_COMPATIBLE_API_KEY
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=YOUR_MODEL_ID
# Optional lightweight model ID (on the same OPENAI_BASE_URL / OPENAI_API_KEY) used to generate
# concise 2-4 word domain-compatible project names. Falls back to OPENAI_MODEL when unset.
PROJECT_NAME_GEN_MODEL=

GOOGLE_CLOUD_PROJECT=YOUR_GOOGLE_CLOUD_PROJECT
GOOGLE_STORAGE_BUCKET=YOUR_PRIVATE_BUCKET
# For local development, point to the downloaded service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=
# A service-account JSON object encoded as a single line. If omitted,
# Application Default Credentials are used.
GOOGLE_STORAGE_CREDENTIALS=

# 32 random bytes, base64. Encrypts project secrets at rest. Generate: openssl rand -base64 32
COGNIX_SECRETS_KEY=

# GitHub OAuth App: github.com/settings/developers → OAuth Apps → New OAuth App
#   Homepage URL:               same as APP_BASE_URL (e.g. http://localhost:3000)
#   Authorization callback URL: {APP_BASE_URL}/api/github/callback
#                               (e.g. http://localhost:3000/api/github/callback)
# Copy the Client ID, then click "Generate a new client secret" and copy it.
# Tokens are encrypted with COGNIX_SECRETS_KEY, so that must be set too.
GITHUB_CLIENT_ID=YOUR_GITHUB_OAUTH_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_OAUTH_CLIENT_SECRET
# GitHub Apps only: the app's URL name from https://github.com/apps/<slug>.
# Lets Cognix link straight to the install page. Authorizing a GitHub App is not enough;
# it must also be installed on the account (choose "All repositories").
GITHUB_APP_SLUG=YOUR_GITHUB_APP_SLUG
# GitHub Apps only: the app's private key (App settings → Private keys → Generate a private key).
# With it, commits appear as <your-app>[bot] with the user as co-author, like lovable-dev[bot].
# Paste the .pem contents on one line with \n for newlines, or base64-encode the whole file.
# Without it, commits appear under the user's own account.
GITHUB_APP_PRIVATE_KEY=YOUR_GITHUB_APP_PRIVATE_KEY
