# Copy to /etc/cognix/infra.env and chmod 600 /etc/cognix/infra.env

# Main builder domain (serves Cognix Next.js UI & API)
COGNIX_BUILDER_DOMAIN=curator.codes

# Wildcard preview & published-apps domain
COGNIX_APPS_DOMAIN=curatorsite.in

# Public origin used when injecting the "Edit with Curator" badge
COGNIX_PUBLIC_ORIGIN=https://curator.codes

# Internal upstream URLs
COGNIX_INTERNAL_URL=http://127.0.0.1:3005
COGNIX_EDGE_PROXY_URL=http://127.0.0.1:3006
EDGE_LISTEN_HOST=127.0.0.1
EDGE_LISTEN_PORT=3006

# Must match COGNIX_EDGE_SECRET in /opt/cognix/app/.env.production (openssl rand -hex 32)
COGNIX_EDGE_SECRET=REPLACE_WITH_64_HEX_SECRET

# Cloudflare API token with Zone -> DNS -> Edit on COGNIX_APPS_DOMAIN (for Caddy wildcard DNS-01 TLS)
CLOUDFLARE_API_TOKEN=REPLACE_WITH_CLOUDFLARE_DNS_EDIT_TOKEN

# Caddy bind settings:
# - Behind Coolify / Traefik: CADDY_HTTP_PORT=8088, CADDY_HTTPS_PORT=8443, CADDY_BIND="127.0.0.1 10.0.0.1"
# - Standalone VM:            CADDY_HTTP_PORT=80,   CADDY_HTTPS_PORT=443,  CADDY_BIND="0.0.0.0"
CADDY_HTTP_PORT=8088
CADDY_HTTPS_PORT=8443
CADDY_BIND="127.0.0.1 10.0.0.1"
