[Unit]
Description=Cognix Caddy Reverse Proxy (Wildcard DNS-01 + On-Demand TLS)
After=network-online.target cognix-app.service cognix-edge.service
Wants=network-online.target

[Service]
Type=notify
EnvironmentFile=/etc/cognix/infra.env
Environment=XDG_DATA_HOME=/var/lib/caddy
Environment=XDG_CONFIG_HOME=/var/lib/caddy/config
ExecStart=/usr/local/bin/caddy run --environ --config /etc/cognix/Caddyfile --adapter caddyfile
ExecReload=/usr/local/bin/caddy reload --config /etc/cognix/Caddyfile --adapter caddyfile --force
TimeoutStopSec=5s
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
